{
  "name": "cms-frequency-backend",
  "version": "1.0.0",
  "description": "Count–Min Sketch 频次估计与哈希碰撞解释后端（TypeScript + Node.js + SQLite）",
  "type": "module",
  "private": true,
  "bin": {
    "cms": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "start": "npm run build && node dist/server.js",
    "demo": "npm run build && node dist/demo.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
